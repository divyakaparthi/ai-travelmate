  {
    "id": "backfill.create-system-user",
    "label": "Create system user for existing trips",
    "operationClass": "data",
    "target": {
      "id": "postgres"
    },
    "precheck": [
      {
        "description": "System user does not already exist",
        "sql": "\n              SELECT NOT EXISTS (\n                SELECT 1\n                FROM \"public\".\"user\"\n                WHERE \"id\" = '00000000-0000-0000-0000-000000000001'\n              )\n            "
      }
    ],
    "execute": [
      {
        "description": "Create system user",
        "sql": "\n              INSERT INTO \"public\".\"user\"\n                (\"id\", \"email\", \"password\")\n              VALUES\n                (\n                  '00000000-0000-0000-0000-000000000001',\n                  'system@aitravelmate.local',\n                  'migration-placeholder'\n                )\n            "
      }
    ],
    "postcheck": [
      {
        "description": "System user exists",
        "sql": "\n              SELECT EXISTS (\n                SELECT 1\n                FROM \"public\".\"user\"\n                WHERE \"id\" = '00000000-0000-0000-0000-000000000001'\n              )\n            "
      }
    ]
  },
  {
    "id": "backfill.trip-userId",
    "label": "Backfill existing trips with system user",
    "operationClass": "data",
    "target": {
      "id": "postgres"
    },
    "precheck": [
      {
        "description": "Trips without userId exist",
        "sql": "\n              SELECT EXISTS (\n                SELECT 1\n                FROM \"public\".\"trip\"\n                WHERE \"userId\" IS NULL\n              )\n            "
      }
    ],
    "execute": [
      {
        "description": "Assign existing trips to system user",
        "sql": "\n              UPDATE \"public\".\"trip\"\n              SET \"userId\" = '00000000-0000-0000-0000-000000000001'\n              WHERE \"userId\" IS NULL\n            "
      }
    ],
    "postcheck": [
      {
        "description": "All trips have userId",
        "sql": "\n              SELECT NOT EXISTS (\n                SELECT 1\n                FROM \"public\".\"trip\"\n                WHERE \"userId\" IS NULL\n              )\n            "
      }
    ]
  },
